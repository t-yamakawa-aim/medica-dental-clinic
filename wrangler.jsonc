{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medica-dental-clinic",
  "compatibility_date": "2026-07-30",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "2193313d-81ba-4aca-9463-c53d662d64fd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "medica-dental-clinic-media"
    }
  ]
}
