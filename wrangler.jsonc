{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medica-dental-clinic",
  "main": "./dist/index.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webapp-production",
      "database_id": "2193313d-81ba-4aca-9463-c53d662d64fd"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
